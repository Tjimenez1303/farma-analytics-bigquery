# Copy to .env and fill in your values.

# GCP project ID (not the name or number). Optional: empty falls back to
# `gcloud config get-value project`.
GOOGLE_CLOUD_PROJECT=

# Billing account ID. Required to link the project and for `make gcp-budget`.
BILLING_ACCOUNT_ID=000000-000000-000000

# Monthly budget amount in the billing account currency (e.g. 10USD, 40000COP).
# Required for `make gcp-budget`.
BUDGET_AMOUNT=10USD

# Daily project query quota in GiB (integer > 0). Required for `make gcp-quota`.
QUERY_QUOTA_GIB_PER_DAY=100

# Optional: timeout in seconds for each remote call made by `make doctor`.
# DOCTOR_TIMEOUT=10

# Optional: alternative path to the filler-word list used by `make lint-prosa`.
# LINT_PROSA_MULETILLAS=scripts/muletillas.txt
